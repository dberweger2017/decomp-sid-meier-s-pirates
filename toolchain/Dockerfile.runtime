# The host layer is identical to the checked research environment.
FROM --platform=linux/amd64 ubuntu:16.04@sha256:1f1a2d56de1d604801a9671f301190704c25d604a416f59e03c04f5c6ffee0d6
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake python curl ca-certificates libgmp-dev libmpfr-dev zlib1g-dev flex bison autoconf automake libtool libssl-dev uuid-dev && rm -rf /var/lib/apt/lists/*
COPY provenance/package-versions.lock /tmp/package-versions.lock
RUN dpkg-query -W -f='${Package}=${Version}\n' > /tmp/installed.lock && diff -u /tmp/package-versions.lock /tmp/installed.lock
COPY install/ /opt/pirates/
# Includes pinned source archives, licenses within those archives, build scripts,
# host patches, package inventory, and installed-artifact fingerprints.
COPY provenance/ /opt/pirates/provenance/
ENV PATH=/opt/pirates/bin:$PATH LC_ALL=C TZ=UTC SOURCE_DATE_EPOCH=0
WORKDIR /work
CMD ["llvm-g++", "--version"]
