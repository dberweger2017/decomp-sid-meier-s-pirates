:80 {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
    @write not method GET HEAD
    respond @write "Read-only published snapshot" 405
    handle /api/* {
        respond "Local developer APIs are unavailable" 404
    }
    handle /deployment.json {
        root * /srv/pirates/state
        header Cache-Control "no-store"
        file_server
    }
    handle_path /releases/* {
        root * /srv/pirates/releases
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/pirates/current
        header Cache-Control "no-store"
        file_server
    }
}
